; THE STRANGEST FLEA MARKET in Godot: the first test (one building, the Walker). Read README.md.
config_version=5

[application]

config/name="The Strangest Flea Market"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.5", "GL Compatibility")
boot_splash/show_image=false
boot_splash/bg_color=Color(0.054902, 0.0627451, 0.0862745, 1)
boot_splash/minimum_display_time=0
config/icon=""

[display]

window/size/viewport_width=1095
window/size/viewport_height=765
window/stretch/mode="disabled"
window/dpi/allow_hidpi=false

[input_devices]

pointing/emulate_touch_from_mouse=false

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
textures/default_filters/use_nearest_mipmap_filter=true
anti_aliasing/quality/msaa_3d=0
environment/defaults/default_clear_color=Color(0.054902, 0.0627451, 0.0862745, 1)
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/16_bits=false
lights_and_shadows/positional_shadow/atlas_16_bits=false
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=2
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=2
limits/opengl/max_lights_per_object=8
